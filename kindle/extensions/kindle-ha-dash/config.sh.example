#!/bin/sh
# Copy to config.sh. This is sourced shell; quote values and keep it private.
# shellcheck disable=SC2034

BASE_URL='https://home.example.com' # No trailing query, fragment or credentials.
TOKEN='replace_with_your_token'    # Sent as a percent-encoded URL path segment.

# All times are integer seconds. Invalid/missing headers use the fallback,
# then both server and fallback intervals are clamped to MIN..MAX.
FALLBACK_SLEEP_SECONDS=1800
MIN_SLEEP_SECONDS=60              # Must be >= 1; 60 recommended.
MAX_SLEEP_SECONDS=7200            # Must be >= MIN.
AWAKE_INTERVAL_SECONDS=300        # Charging/debug: no suspend, Wi-Fi stays on.
WIFI_TIMEOUT_SECONDS=30           # Per attempt, must be >= 1.
WIFI_RETRIES=2                    # Retries after first attempt; 0..20.
HTTP_TIMEOUT_SECONDS=45          # curl total time budget, must be >= 1.
LOW_BATTERY_PERCENT=10           # 0..100; unknown battery does not inhibit fetch.

STOP_FRAMEWORK=0                 # 1 stops the jobs below; stop/exit restarts them.
# FRAMEWORK_JOBS='framework lab126_gui' # Change to match installed Upstart jobs.

RTC_DEVICE=''                    # Auto: /sys/class/rtc/rtc1 if wakealarm exists,
                                 # else rtc0. Set to an RTC DIRECTORY, not node.
# POWER_STATE_PATH='/sys/power/state'
# RESUME_DELAY_SECONDS=3          # Delay after suspend returns, before Wi-Fi I/O.
# WIFI_TOGGLE_DELAY_SECONDS=2

HTTP_CLIENT_BIN=''               # Auto: extension bin/curl, USBNetwork curl,
                                 # then PATH curl. A binary path, no arguments.
CA_BUNDLE=''                     # Optional readable PEM CA bundle path.
INSECURE_TLS=0                   # 1 disables identity verification: last resort!
                                 # A network attacker could obtain your token.

LOG_FILE='/mnt/us/extensions/kindle-ha-dash/dashboard.log'
LOG_MAX_BYTES=131072             # >= 1024; keep one .old after the limit.

# FBINK_BIN='auto'               # Auto: PATH, /mnt/us/libkh/bin/fbink,
                                 # /mnt/us/koreader[/bin]/fbink. '' forces eips.
# EIPS_STATUS_COL=0
# EIPS_STATUS_ROW=59              # Auto parses eips -i rows, else PW3 default 59.

# Advanced overrides (defaults shown). State/cache in RAM; no persistent writes
# except logs/config. Changing STATE_DIR relocates derived paths unless explicit.
# STATE_DIR='/tmp/kindle-ha-dash'
# PIDFILE='/tmp/kindle-ha-dash/dash.pid'
# TEMP_DIR='/tmp/kindle-ha-dash/work'
# IMAGE_FILE='/tmp/kindle-ha-dash/image.png' # Keep on same filesystem as TEMP_DIR.
# FRAMEWORK_MARKER='/tmp/kindle-ha-dash/framework-stopped'
# DEBUG_FILE='/mnt/us/kindle-ha-dash.debug'
# STOP_FILE='/mnt/us/kindle-ha-dash.stop'
# LIPC_SET_BIN='lipc-set-prop'
# LIPC_GET_BIN='lipc-get-prop'
# GASGAUGE_BIN='gasgauge-info'
# USB_POWER_PATH='/sys/devices/system/wario_charger/wario_charger0/connected'
# CHARGING_PATH='/sys/devices/system/wario_charger/wario_charger0/charging'
# EIPS_BIN='eips'
# START_BIN='start'
# STOP_BIN='stop'
# SLEEP_BIN='sleep'
# DATE_BIN='date'
# KILL_BIN='kill'
# PROC_ROOT='/proc'
# RTC_ROOT='/sys/class/rtc'        # Used for auto-detection and selftest listing.
# FIRMWARE_FILE='/etc/prettyversion.txt' # selftest only.

# Seconds to wait after wifi-off before repainting the image (hides the stock
# airplane-mode icon). 0 disables the repaint.
WIFI_OFF_REDRAW_DELAY_SECONDS=3
